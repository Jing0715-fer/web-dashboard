{
  "version": "1.0",
  "description": "Project Manager Configuration — Single source of truth for both the dashboard and project-manager.sh",
  "logDir": "/Users/lijing/Projects/.project-logs",
  "pidDir": "/Users/lijing/Projects/.project-pids",
  "portConvention": {
    "description": "prod = dev + 1000 (except dashboard/pdb-tracker)",
    "dashboard": { "dev": 3000, "prod": 4000 },
    "pdb-tracker": { "dev": 3003, "prod": 4003 },
    "default": "dev + 1000"
  },
  "projects": [
    {
      "name": "Dashboard",
      "path": "/Users/lijing/Projects/web-dashboard",
      "description": "Main project management dashboard — Next.js web app for monitoring and controlling all sub-projects",
      "icon": "monitor",
      "tags": ["Frontend", "Fullstack"],
      "environments": [
        {
          "name": "development",
          "cmd": "npm run dev",
          "port": 3000,
          "envVars": {}
        },
        {
          "name": "production",
          "cmd": "node .next/standalone/server.js",
          "port": 4000,
          "envVars": { "NODE_ENV": "production" }
        }
      ]
    },
