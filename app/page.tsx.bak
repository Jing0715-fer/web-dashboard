  deploy: 'text-emerald-500 bg-emerald-100 dark:bg-emerald-900/30',
  start: 'text-green-500 bg-green-100 dark:bg-green-900/30',
  stop: 'text-red-500 bg-red-100 dark:bg-red-900/30',
